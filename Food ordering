package com.example.foodordering;

import android.database.Cursor;
import android.os.Bundle;
import android.widget.Button;
import android.widget.EditText;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText etOrderId;
    Button btnDelete, btnView, btnAddSample;
    TextView txtResult;
    DatabaseHelper dbHelper;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        etOrderId = findViewById(R.id.etOrderId);
        btnDelete = findViewById(R.id.btnDelete);
        btnView = findViewById(R.id.btnView);
        btnAddSample = findViewById(R.id.btnAddSample);
        txtResult = findViewById(R.id.txtResult);

        dbHelper = new DatabaseHelper(this);

        // READ & DISPLAY ORDERS
        btnView.setOnClickListener(v -> displayOrders());

        // DELETE ORDER
        btnDelete.setOnClickListener(v -> {
            String idStr = etOrderId.getText().toString();
            if (!idStr.isEmpty()) {
                int orderId = Integer.parseInt(idStr);
                dbHelper.deleteOrder(orderId);
                Toast.makeText(this, "Order Deleted Successfully", Toast.LENGTH_SHORT).show();
                etOrderId.setText("");
                displayOrders(); // Refresh list after deletion
            } else {
                Toast.makeText(this, "Please enter an Order ID", Toast.LENGTH_SHORT).show();
            }
        });

        // ADD SAMPLE ORDER (To populate data for testing)
        btnAddSample.setOnClickListener(v -> {
            dbHelper.insertOrder("John Doe", "123 Main St", "Pizza, Coke", 24.99);
            Toast.makeText(this, "Sample Order Added", Toast.LENGTH_SHORT).show();
            displayOrders();
        });
    }

    private void displayOrders() {
        Cursor cursor = dbHelper.getAllOrders();
        if (cursor.getCount() == 0) {
            txtResult.setText("No orders found.");
            cursor.close();
            return;
        }

        StringBuilder data = new StringBuilder();
        while (cursor.moveToNext()) {
            int orderId = cursor.getInt(0);
            String name = cursor.getString(1);
            String address = cursor.getString(2);
            String items = cursor.getString(3);
            double amount = cursor.getDouble(4);

            data.append("Order ID: ").append(orderId).append("\n");
            data.append("Customer Name: ").append(name).append("\n");
            data.append("Delivery Address: ").append(address).append("\n");
            data.append("Items: ").append(items).append("\n");
            data.append("Payment Amount: $").append(amount).append("\n");
            data.append("-----------------------------------\n");
        }
        cursor.close();
        txtResult.setText(data.toString());
    }
}
