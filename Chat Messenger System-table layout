package com.example.chatmessenger;

import android.content.ContentValues;
import android.content.Context;
import android.database.Cursor;
import android.database.sqlite.SQLiteDatabase;
import android.database.sqlite.SQLiteOpenHelper;

public class DatabaseHelper extends SQLiteOpenHelper {

    public DatabaseHelper(Context context) {
        super(context, "ChatTable.db", null, 1);
    }

    @Override
    public void onCreate(SQLiteDatabase db) {
        db.execSQL("CREATE TABLE Messages (" +
                "Message_ID INTEGER PRIMARY KEY AUTOINCREMENT, " +
                "Sender_Name TEXT, " +
                "Receiver_Name TEXT, " +
                "Message_Text TEXT, " +
                "Timestamp TEXT" +
                ");");
    }

    @Override
    public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
        db.execSQL("DROP TABLE IF EXISTS Messages");
        onCreate(db);
    }

    // Helper method to insert a sample message record
    public void insertMessage(String senderName, String receiverName, String messageText, String timestamp) {
        SQLiteDatabase db = this.getWritableDatabase();
        ContentValues values = new ContentValues();
        values.put("Sender_Name", senderName);
        values.put("Receiver_Name", receiverName);
        values.put("Message_Text", messageText);
        values.put("Timestamp", timestamp);
        db.insert("Messages", null, values);
        db.close();
    }

    // READ: Get all messages
    public Cursor getAllMessages() {
        SQLiteDatabase db = this.getReadableDatabase();
        return db.rawQuery("SELECT * FROM Messages", null);
    }

    // DELETE: Delete message by Message_ID
    public void deleteMessage(int messageId) {
        SQLiteDatabase db = this.getWritableDatabase();
        db.delete("Messages", "Message_ID = ?", new String[]{String.valueOf(messageId)});
        db.close();
    }
}



