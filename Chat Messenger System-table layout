package com.example.chatmessenger;

import android.database.Cursor;
import android.os.Bundle;
import android.widget.Button;
import android.widget.EditText;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText etMessageId;
    Button btnDelete, btnView, btnAddSample;
    TextView txtResult;
    DatabaseHelper dbHelper;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        etMessageId = findViewById(R.id.etMessageId);
        btnDelete = findViewById(R.id.btnDelete);
        btnView = findViewById(R.id.btnView);
        btnAddSample = findViewById(R.id.btnAddSample);
        txtResult = findViewById(R.id.txtResult);

        dbHelper = new DatabaseHelper(this);

        // READ & DISPLAY MESSAGES
        btnView.setOnClickListener(v -> displayMessages());

        // DELETE MESSAGE
        btnDelete.setOnClickListener(v -> {
            String idStr = etMessageId.getText().toString();
            if (!idStr.isEmpty()) {
                int messageId = Integer.parseInt(idStr);
                dbHelper.deleteMessage(messageId);
                Toast.makeText(this, "Message Deleted Successfully", Toast.LENGTH_SHORT).show();
                etMessageId.setText("");
                displayMessages();
            } else {
                Toast.makeText(this, "Please enter a Message ID", Toast.LENGTH_SHORT).show();
            }
        });

        // ADD SAMPLE MESSAGE
        btnAddSample.setOnClickListener(v -> {
            dbHelper.insertMessage("David", "Emma", "See you tomorrow!", "02:15 PM");
            Toast.makeText(this, "Sample Message Added", Toast.LENGTH_SHORT).show();
            displayMessages();
        });
    }

    private void displayMessages() {
        Cursor cursor = dbHelper.getAllMessages();
        if (cursor.getCount() == 0) {
            txtResult.setText("No messages found.");
            cursor.close();
            return;
        }

        StringBuilder data = new StringBuilder();
        while (cursor.moveToNext()) {
            int messageId = cursor.getInt(0);
            String sender = cursor.getString(1);
            String receiver = cursor.getString(2);
            String messageText = cursor.getString(3);
            String timestamp = cursor.getString(4);

            data.append("Message ID: ").append(messageId).append("\n");
            data.append("From: ").append(sender).append(" | To: ").append(receiver).append("\n");
            data.append("Text: ").append(messageText).append("\n");
            data.append("Time: ").append(timestamp).append("\n");
            data.append("-----------------------------------\n");
        }
        cursor.close();
        txtResult.setText(data.toString());
    }
}
