package com.example.eventbooking;

import android.database.Cursor;
import android.os.Bundle;
import android.widget.Button;
import android.widget.EditText;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText etEventName, etCustomerName, etTicketQuantity, etTotalPrice;
    Button btnSave, btnView;
    TextView txtResult;
    DatabaseHelper dbHelper;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        etEventName = findViewById(R.id.etEventName);
        etCustomerName = findViewById(R.id.etCustomerName);
        etTicketQuantity = findViewById(R.id.etTicketQuantity);
        etTotalPrice = findViewById(R.id.etTotalPrice);
        btnSave = findViewById(R.id.btnSave);
        btnView = findViewById(R.id.btnView);
        txtResult = findViewById(R.id.txtResult);

        dbHelper = new DatabaseHelper(this);

        // INSERT BOOKING
        btnSave.setOnClickListener(v -> {
            String eventName = etEventName.getText().toString();
            String customerName = etCustomerName.getText().toString();
            String qtyStr = etTicketQuantity.getText().toString();
            String priceStr = etTotalPrice.getText().toString();

            if (!eventName.isEmpty() && !customerName.isEmpty() && !qtyStr.isEmpty() && !priceStr.isEmpty()) {
                int quantity = Integer.parseInt(qtyStr);
                double price = Double.parseDouble(priceStr);

                dbHelper.insertBooking(eventName, customerName, quantity, price);
                Toast.makeText(this, "Ticket Booked Successfully", Toast.LENGTH_SHORT).show();

                etEventName.setText("");
                etCustomerName.setText("");
                etTicketQuantity.setText("");
                etTotalPrice.setText("");
                displayBookings();
            } else {
                Toast.makeText(this, "Please fill all fields", Toast.LENGTH_SHORT).show();
            }
        });

        // READ & DISPLAY BOOKINGS
        btnView.setOnClickListener(v -> displayBookings());
    }

    private void displayBookings() {
        Cursor cursor = dbHelper.getAllBookings();
        if (cursor.getCount() == 0) {
            txtResult.setText("No bookings found.");
            cursor.close();
            return;
        }

        StringBuilder data = new StringBuilder();
        while (cursor.moveToNext()) {
            int bookingId = cursor.getInt(0);
            String event = cursor.getString(1);
            String customer = cursor.getString(2);
            int quantity = cursor.getInt(3);
            double price = cursor.getDouble(4);

            data.append("Booking ID: ").append(bookingId).append("\n");
            data.append("Event: ").append(event).append("\n");
            data.append("Customer: ").append(customer).append("\n");
            data.append("Quantity: ").append(quantity).append("\n");
            data.append("Total Price: $").append(price).append("\n");
            data.append("-----------------------------------\n");
        }
        cursor.close();
        txtResult.setText(data.toString());
    }
}
}
