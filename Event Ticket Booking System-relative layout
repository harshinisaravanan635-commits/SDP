package com.example.eventbookingrel;

import android.database.Cursor;
import android.os.Bundle;
import android.widget.Button;
import android.widget.EditText;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText etBookingId, etEventName, etCustomerName, etTicketQuantity, etTotalPrice;
    Button btnUpdate, btnView, btnAddSample;
    TextView txtResult;
    DatabaseHelper dbHelper;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        etBookingId = findViewById(R.id.etBookingId);
        etEventName = findViewById(R.id.etEventName);
        etCustomerName = findViewById(R.id.etCustomerName);
        etTicketQuantity = findViewById(R.id.etTicketQuantity);
        etTotalPrice = findViewById(R.id.etTotalPrice);

        btnUpdate = findViewById(R.id.btnUpdate);
        btnView = findViewById(R.id.btnView);
        btnAddSample = findViewById(R.id.btnAddSample);
        txtResult = findViewById(R.id.txtResult);

        dbHelper = new DatabaseHelper(this);

        // READ & DISPLAY BOOKINGS
        btnView.setOnClickListener(v -> displayBookings());

        // UPDATE BOOKING
        btnUpdate.setOnClickListener(v -> {
            String idStr = etBookingId.getText().toString();
            String eventName = etEventName.getText().toString();
            String customerName = etCustomerName.getText().toString();
            String qtyStr = etTicketQuantity.getText().toString();
            String priceStr = etTotalPrice.getText().toString();

            if (!idStr.isEmpty() && !eventName.isEmpty() && !qtyStr.isEmpty() && !priceStr.isEmpty()) {
                int bookingId = Integer.parseInt(idStr);
                int quantity = Integer.parseInt(qtyStr);
                double price = Double.parseDouble(priceStr);

                dbHelper.updateBooking(bookingId, eventName, customerName, quantity, price);
                Toast.makeText(this, "Booking Updated Successfully", Toast.LENGTH_SHORT).show();
                displayBookings();
            } else {
                Toast.makeText(this, "Please enter Booking ID, Event Name, Quantity, and Price", Toast.LENGTH_SHORT).show();
            }
        });

        // ADD SAMPLE BOOKING
        btnAddSample.setOnClickListener(v -> {
            dbHelper.insertBooking("Rock Concert", "Diana Prince", 2, 120.00);
            Toast.makeText(this, "Sample Booking Added", Toast.LENGTH_SHORT).show();
            displayBookings();
        });
    }

    private void displayBookings() {
        Cursor cursor = dbHelper.getAllBookings();
        if (cursor.getCount() == 0) {
            txtResult.setText("No bookings found.");
            cursor.close();
            return;
        }

        StringBuilder data = new StringBuilder();
        while (cursor.moveToNext()) {
            int bookingId = cursor.getInt(0);
            String event = cursor.getString(1);
            String customer = cursor.getString(2);
            int quantity = cursor.getInt(3);
            double price = cursor.getDouble(4);

            data.append("Booking ID: ").append(bookingId).append("\n");
            data.append("Event: ").append(event).append("\n");
            data.append("Customer: ").append(customer).append("\n");
            data.append("Quantity: ").append(quantity).append("\n");
            data.append("Total Price: $").append(price).append("\n");
            data.append("-----------------------------------\n");
        }
        cursor.close();
        txtResult.setText(data.toString());
    }
}
