package com.example.eventbookingrel;

import android.content.ContentValues;
import android.content.Context;
import android.database.Cursor;
import android.database.sqlite.SQLiteDatabase;
import android.database.sqlite.SQLiteOpenHelper;

public class DatabaseHelper extends SQLiteOpenHelper {

    public DatabaseHelper(Context context) {
        super(context, "EventBookingRel.db", null, 1);
    }

    @Override
    public void onCreate(SQLiteDatabase db) {
        db.execSQL("CREATE TABLE Bookings (" +
                "Booking_ID INTEGER PRIMARY KEY AUTOINCREMENT, " +
                "Event_Name TEXT, " +
                "Customer_Name TEXT, " +
                "Ticket_Quantity INTEGER, " +
                "Total_Price REAL" +
                ");");
    }

    @Override
    public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
        db.execSQL("DROP TABLE IF EXISTS Bookings");
        onCreate(db);
    }

    // Helper method to insert a sample booking record
    public void insertBooking(String eventName, String customerName, int ticketQuantity, double totalPrice) {
        SQLiteDatabase db = this.getWritableDatabase();
        ContentValues values = new ContentValues();
        values.put("Event_Name", eventName);
        values.put("Customer_Name", customerName);
        values.put("Ticket_Quantity", ticketQuantity);
        values.put("Total_Price", totalPrice);
        db.insert("Bookings", null, values);
        db.close();
    }

    // READ: Get all bookings
    public Cursor getAllBookings() {
        SQLiteDatabase db = this.getReadableDatabase();
        return db.rawQuery("SELECT * FROM Bookings", null);
    }

    // UPDATE: Update booking record by Booking_ID
    public void updateBooking(int bookingId, String eventName, String customerName, int ticketQuantity, double totalPrice) {
        SQLiteDatabase db = this.getWritableDatabase();
        ContentValues values = new ContentValues();
        values.put("Event_Name", eventName);
        values.put("Customer_Name", customerName);
        values.put("Ticket_Quantity", ticketQuantity);
        values.put("Total_Price", totalPrice);
        db.update("Bookings", values, "Booking_ID = ?", new String[]{String.valueOf(bookingId)});
        db.close();
    }
}


