package com.example.foodbillsrel;

import android.database.Cursor;
import android.os.Bundle;
import android.widget.Button;
import android.widget.EditText;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText etBillId;
    Button btnDelete, btnView, btnAddSample;
    TextView txtResult;
    DatabaseHelper dbHelper;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        etBillId = findViewById(R.id.etBillId);
        btnDelete = findViewById(R.id.btnDelete);
        btnView = findViewById(R.id.btnView);
        btnAddSample = findViewById(R.id.btnAddSample);
        txtResult = findViewById(R.id.txtResult);

        dbHelper = new DatabaseHelper(this);

        // READ & DISPLAY BILLS
        btnView.setOnClickListener(v -> displayBills());

        // DELETE BILL
        btnDelete.setOnClickListener(v -> {
            String idStr = etBillId.getText().toString();
            if (!idStr.isEmpty()) {
                int billId = Integer.parseInt(idStr);
                dbHelper.deleteBill(billId);
                Toast.makeText(this, "Bill Deleted Successfully", Toast.LENGTH_SHORT).show();
                etBillId.setText("");
                displayBills();
            } else {
                Toast.makeText(this, "Please enter a Bill ID", Toast.LENGTH_SHORT).show();
            }
        });

        // ADD SAMPLE BILL
        btnAddSample.setOnClickListener(v -> {
            dbHelper.insertBill("Charlie Brown", "Steak, Fries, Soda", 4.25, 34.25);
            Toast.makeText(this, "Sample Bill Added", Toast.LENGTH_SHORT).show();
            displayBills();
        });
    }

    private void displayBills() {
        Cursor cursor = dbHelper.getAllBills();
        if (cursor.getCount() == 0) {
            txtResult.setText("No bills found.");
            cursor.close();
            return;
        }

        StringBuilder data = new StringBuilder();
        while (cursor.moveToNext()) {
            int billId = cursor.getInt(0);
            String name = cursor.getString(1);
            String items = cursor.getString(2);
            double tax = cursor.getDouble(3);
            double total = cursor.getDouble(4);

            data.append("Bill ID: ").append(billId).append("\n");
            data.append("Customer: ").append(name).append("\n");
            data.append("Items: ").append(items).append("\n");
            data.append("Tax Amount: $").append(tax).append("\n");
            data.append("Total Bill: $").append(total).append("\n");
            data.append("-----------------------------------\n");
        }
        cursor.close();
        txtResult.setText(data.toString());
    }
}
