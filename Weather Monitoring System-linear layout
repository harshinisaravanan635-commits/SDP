package com.example.weathermonitoringlin;

import android.database.Cursor;
import android.os.Bundle;
import android.widget.Button;
import android.widget.EditText;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText etReportId, etCityName, etTemperature, etHumidity, etWeatherCondition;
    Button btnUpdate, btnView, btnAddSample;
    TextView txtResult;
    DatabaseHelper dbHelper;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        etReportId = findViewById(R.id.etReportId);
        etCityName = findViewById(R.id.etCityName);
        etTemperature = findViewById(R.id.etTemperature);
        etHumidity = findViewById(R.id.etHumidity);
        etWeatherCondition = findViewById(R.id.etWeatherCondition);
        
        btnUpdate = findViewById(R.id.btnUpdate);
        btnView = findViewById(R.id.btnView);
        btnAddSample = findViewById(R.id.btnAddSample);
        txtResult = findViewById(R.id.txtResult);

        dbHelper = new DatabaseHelper(this);

        // READ & DISPLAY WEATHER REPORTS
        btnView.setOnClickListener(v -> displayReports());

        // UPDATE WEATHER RECORD
        btnUpdate.setOnClickListener(v -> {
            String idStr = etReportId.getText().toString();
            String city = etCityName.getText().toString();
            String temp = etTemperature.getText().toString();
            String humidity = etHumidity.getText().toString();
            String condition = etWeatherCondition.getText().toString();

            if (!idStr.isEmpty() && !city.isEmpty()) {
                int reportId = Integer.parseInt(idStr);
                dbHelper.updateReport(reportId, city, temp, humidity, condition);
                Toast.makeText(this, "Weather Report Updated Successfully", Toast.LENGTH_SHORT).show();
                displayReports();
            } else {
                Toast.makeText(this, "Please enter Report ID and City Name", Toast.LENGTH_SHORT).show();
            }
        });

        // ADD SAMPLE RECORD
        btnAddSample.setOnClickListener(v -> {
            dbHelper.insertReport("London", "15°C", "80%", "Showers");
            Toast.makeText(this, "Sample Weather Record Added", Toast.LENGTH_SHORT).show();
            displayReports();
        });
    }

    private void displayReports() {
        Cursor cursor = dbHelper.getAllReports();
        if (cursor.getCount() == 0) {
            txtResult.setText("No weather reports found.");
            cursor.close();
            return;
        }

        StringBuilder data = new StringBuilder();
        while (cursor.moveToNext()) {
            int reportId = cursor.getInt(0);
            String city = cursor.getString(1);
            String temp = cursor.getString(2);
            String humidity = cursor.getString(3);
            String condition = cursor.getString(4);

            data.append("Report ID: ").append(reportId).append("\n");
            data.append("City Name: ").append(city).append("\n");
            data.append("Temperature: ").append(temp).append("\n");
            data.append("Humidity: ").append(humidity).append("\n");
            data.append("Weather Condition: ").append(condition).append("\n");
            data.append("-----------------------------------\n");
        }
        cursor.close();
        txtResult.setText(data.toString());
    }
}
}
